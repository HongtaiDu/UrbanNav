<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="32dp">

        <!-- Beacon name -->
        <TextView
            android:id="@+id/text_beacon_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A202C"
            android:layout_marginBottom="4dp" />

        <!-- MAC address -->
        <TextView
            android:id="@+id/text_beacon_mac"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="#718096"
            android:layout_marginBottom="32dp" />

        <!-- ── Calibration progress block ── -->

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap START to begin 45-second calibration"
            android:textSize="15sp"
            android:textColor="#4A5568"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <!-- Countdown -->
        <TextView
            android:id="@+id/text_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="45"
            android:textSize="64sp"
            android:textStyle="bold"
            android:textColor="#1A202C"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="seconds remaining"
            android:textSize="14sp"
            android:textColor="#9AA5B4"
            android:layout_marginBottom="24dp" />

        <!-- Progress bar -->
        <ProgressBar
            android:id="@+id/progress_calibration"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="45"
            android:progress="0"
            android:layout_marginBottom="8dp" />

        <!-- Sample counter -->
        <TextView
            android:id="@+id/text_sample_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Samples: 0"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textColor="#9AA5B4"
            android:layout_marginBottom="24dp" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EDF2F7"
            android:layout_marginBottom="24dp" />

        <!-- Live RSSI -->
        <TextView
            android:id="@+id/text_live_rssi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live RSSI: —"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:textColor="#4A5568"
            android:layout_marginBottom="8dp" />

        <!-- Running average -->
        <TextView
            android:id="@+id/text_running_avg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Running avg: —"
            android:textSize="15sp"
            android:fontFamily="monospace"
            android:textColor="#3182CE"
            android:layout_marginBottom="32dp" />

        <!-- ── Result block (hidden until done) ── -->

        <LinearLayout
            android:id="@+id/layout_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#EBF8FF"
            android:padding="24dp"
            android:layout_marginBottom="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Calibration Complete"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#2B6CB0"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Average RSSI at 1m"
                android:textSize="13sp"
                android:textColor="#4A5568"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/text_final_avg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="52sp"
                android:textStyle="bold"
                android:textColor="#1A202C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="dBm"
                android:textSize="18sp"
                android:textColor="#718096"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/text_final_samples"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:textColor="#9AA5B4" />

        </LinearLayout>

        <!-- Start / Restart button -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▶  Start Calibration"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <!-- Go back -->
        <Button
            android:id="@+id/btn_go_back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="← Back to List"
            android:textAllCaps="false"
            android:textSize="15sp" />

    </LinearLayout>
</ScrollView>